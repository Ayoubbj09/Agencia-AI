---
/**
 * 7.1 Hero (#inicio) — PROPIETARIO: Sección A. Script: src/scripts/sections/hero.ts
 *
 * Único <h1> de la home.
 *
 * Fondo (capas, de abajo arriba, todo aria-hidden):
 *  1. .hero__fallback — composición CSS de reserva: un "pool" de luz ámbar y dos
 *     haces que se encuentran arriba a la derecha (el relevo). Es lo que se ve
 *     sin JS, con reduced motion (estático), sin WebGL en escritorio (con una
 *     deriva muy lenta) y mientras carga lo siguiente.
 *  2a. Escritorio: canvas WebGL (OGL) — lo inserta hero.ts tras `load` +
 *     requestIdleCallback y si hay WebGL. Dos formas de metal líquido que se
 *     buscan y se pasan la energía.
 *  2b. Táctil: canvas 2D con un fotograma fijo exportado del propio WebGL
 *     (src/assets/hero/*.avif, ~7 KB), también tras `load`.
 *     Ningún canvas es candidato a LCP.
 *  3. Viñeta inferior para fundir con la sección siguiente.
 *
 * Preloader (spec §9, opcional): NO se usa. Desde un componente de sección se
 * pinta después de la nav (la nav aparecía un instante antes que el telón) y no
 * aporta al LCP; la entrada del hero (titular + WebGL) ya hace de apertura.
 */
import WhatsAppButton from '../WhatsAppButton.astro';
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="hero__visual" data-hero-visual aria-hidden="true">
    <div class="hero__fallback" data-hero-fallback>
      <div class="hero__drift">
        <span class="hero__glow hero__glow--pool"></span>
        <span class="hero__glow hero__form hero__form--a"></span>
        <span class="hero__glow hero__form hero__form--b"></span>
        <span class="hero__glow hero__glow--spark"></span>
      </div>
    </div>
  </div>

  <div class="hero__content container" data-hero-content>
    <p class="eyebrow hero__eyebrow hero__in" style="--i: 0">Agentes de IA para negocios</p>

    <h1 id="hero-title" class="hero__title" data-reveal="manual" data-hero-title>
      <span class="hero__line">Tu negocio contesta por WhatsApp <em>a cualquier hora</em>.</span>
      <span class="hero__line hero__line--soft">Y cuando importa, te avisa a&nbsp;ti.</span>
    </h1>

    <div class="hero__bottom">
      <p class="hero__sub hero__in hero__in--drift" style="--i: 1">
        En Ahlan IA diseñamos, montamos y mantenemos agentes de IA que atienden a tus clientes,
        los cualifican, agendan citas y avisan a tu equipo cuando hace falta.
      </p>
      <div class="hero__ctas">
        <div class="hero__in" style="--i: 2">
          <WhatsAppButton label="Escríbenos por WhatsApp" size="lg" />
        </div>
        <div class="hero__in" style="--i: 3">
          <a class="btn btn--ghost btn--lg hero__secondary" href="#que-hace" data-cursor-hover>
            Ver cómo funciona
          </a>
        </div>
      </div>
    </div>
  </div>

  <a
    class="hero__scroll hero__in hero__in--fade"
    style="--i: 9"
    href="#narracion"
    aria-label="Desliza: bajar a la siguiente sección"
  >
    <span class="hero__scroll-inner" data-hero-cue>
      <span class="hero__scroll-text" aria-hidden="true">Desliza</span>
      <span class="hero__scroll-line" aria-hidden="true"></span>
    </span>
  </a>
</section>

<style>
  /* ════════════════════════════════════════════════════════════════════════
     Hero
     ════════════════════════════════════════════════════════════════════════ */
  .hero {
    /* Punto de encuentro de la composición de reserva (≈ el del WebGL). */
    --mx: 74%;
    --my: 27%;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    padding-top: calc(var(--nav-h) + var(--space-xl));
    padding-bottom: var(--space-xl);
    isolation: isolate;
  }
  @media (max-width: 63.999em) {
    .hero {
      /* Mismo encuentro que el fotograma fijo vertical: el fundido no salta. */
      --mx: 62%;
      --my: 16%;
    }
  }

  /* ── Fondo ──────────────────────────────────────────────────────────────── */
  .hero__visual {
    position: absolute;
    inset: 0;
    z-index: var(--z-below);
    overflow: hidden;
    pointer-events: none;
  }
  .hero__fallback,
  .hero__drift {
    position: absolute;
    inset: 0;
  }
  /* Con el WebGL ya visible, la reserva no se pinta (ni se anima). */
  .hero__visual.is-gl .hero__fallback {
    display: none;
  }
  .hero__glow {
    position: absolute;
    left: var(--mx);
    top: var(--my);
    border-radius: 50%;
  }
  /* Pool de luz ámbar profundo alrededor del encuentro. */
  .hero__glow--pool {
    width: max(70rem, 120vmax);
    height: max(48rem, 80vmax);
    translate: -50% -50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--accent-deep) 78%, transparent),
      color-mix(in srgb, var(--accent-deep) 30%, transparent) 38%,
      color-mix(in srgb, var(--accent-deep) 8%, transparent) 68%,
      transparent
    );
  }
  /* Dos formas blandas que llegan casi a tocarse (el relevo), con la punta más
     caliente, y una chispa en el hueco. Misma dirección que el WebGL. */
  .hero__form {
    --gap: clamp(0.9rem, 1.6vw, 1.6rem);
    height: clamp(4.5rem, 7.5vw, 8rem);
    border-radius: 0;
  }
  .hero__form--a {
    width: clamp(20rem, 38vw, 44rem);
    transform-origin: 100% 50%;
    translate: calc(-100% - var(--gap)) -50%;
    rotate: 16deg;
    background:
      radial-gradient(
        22% 38% at 91% 50%,
        color-mix(in srgb, var(--accent-soft) 62%, transparent),
        color-mix(in srgb, var(--accent) 24%, transparent) 50%,
        transparent 78%
      ),
      radial-gradient(
        closest-side,
        color-mix(in srgb, var(--accent-deep) 92%, transparent),
        color-mix(in srgb, var(--accent-deep) 40%, transparent) 62%,
        transparent
      );
  }
  .hero__form--b {
    width: clamp(18rem, 34vw, 40rem);
    transform-origin: 0% 50%;
    translate: var(--gap) -50%;
    rotate: 34deg;
    background:
      radial-gradient(
        20% 36% at 9% 50%,
        color-mix(in srgb, var(--accent-soft) 48%, transparent),
        color-mix(in srgb, var(--accent) 20%, transparent) 50%,
        transparent 78%
      ),
      radial-gradient(
        closest-side,
        color-mix(in srgb, var(--accent-deep) 92%, transparent),
        color-mix(in srgb, var(--accent-deep) 40%, transparent) 62%,
        transparent
      );
  }
  /* La chispa en el hueco: pequeña y cálida. */
  .hero__glow--spark {
    width: clamp(3.5rem, 5vw, 5.5rem);
    aspect-ratio: 1;
    translate: -50% -50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--accent-soft) 70%, transparent),
      color-mix(in srgb, var(--accent) 26%, transparent) 40%,
      transparent
    );
  }
  @media (max-width: 63.999em) {
    /* Vertical, como el fotograma fijo de móvil: A baja desde arriba. */
    .hero__form--a {
      rotate: 58deg;
    }
    .hero__form--b {
      rotate: 52deg;
    }
  }
  /* Spec 7.1: sin WebGL (escritorio) → movimiento muy lento, solo transform.
     Táctil y reduced motion → estático. Misma condición que `desktop`. */
  @media (min-width: 64em) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .hero__drift {
      animation: hero-drift 26s var(--ease-in-out) infinite alternate;
    }
  }
  @keyframes hero-drift {
    to {
      transform: translate3d(-2.5%, 2%, 0) rotate(-3deg) scale(1.04);
    }
  }

  /* Lienzo WebGL (lo crea hero.ts): se escala con CSS desde ~60–75 % de resolución. */
  .hero__visual :global(.hero__canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  /* Táctil: fotograma fijo del WebGL (lo pinta hero.ts en un canvas 2D). */
  .hero__visual :global(.hero__still) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 100% 0%;
    opacity: 0;
  }
  .hero__visual :global(.hero__still[data-orientation='portrait']) {
    object-position: 60% 0%;
  }
  /* Móvil estrecho: el titular empieza muy arriba; se atenúa la parte de las
     formas que queda detrás del texto (contraste AA). Estático: se pinta una vez. */
  @media (max-width: 37.5em) {
    .hero__visual :global(.hero__still[data-orientation='portrait']) {
      mask-image: linear-gradient(
        to bottom,
        black 0%,
        black 18%,
        rgb(0 0 0 / 0.45) 32%,
        rgb(0 0 0 / 0.3) 60%
      );
    }
  }
  .hero__visual.is-still .hero__fallback {
    display: none;
  }

  /* Viñetas (por encima de cualquier lienzo): arriba, oscurece la franja de la
     nav (sus enlaces quedan sobre fondo transparente → contraste AA); abajo, el
     fondo se funde con la sección siguiente. */
  .hero__visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--bg) 82%, transparent) 0,
        color-mix(in srgb, var(--bg) 55%, transparent) calc(var(--nav-h) * 0.75),
        transparent calc(var(--nav-h) * 1.9)
      ),
      linear-gradient(to bottom, transparent 55%, var(--bg) 100%);
  }

  /* ── Entrada (CSS puro) ─────────────────────────────────────────────────
     Eyebrow, subtítulo, CTA e indicador entran con CSS desde la primera
     pintura, sin esperar al JS: el subtítulo es el elemento LCP (en móvil y
     escritorio) y así no depende de que llegue el bundle. El titular (SplitText) sí lo anima
     hero.ts. Solo bajo html.js.motion: sin JS, con reduced motion o en el hueco
     sin modo, todo está visible desde el principio. */
  .hero {
    --hero-delay: 0.15s;
  }
  :global(html.js.motion) .hero__in {
    animation: hero-rise 1.1s var(--ease-out) both;
    animation-delay: calc(var(--hero-delay) + var(--i, 0) * 0.1s);
  }
  :global(html.js.motion) .hero__in--fade {
    animation-name: hero-fade;
  }
  /* El subtítulo solo se desplaza (sin opacidad): así está pintado desde la
     primera pintura y cuenta para el LCP (Chrome ignora lo que se pinta con
     opacity 0 y aparece después con una animación CSS). */
  :global(html.js.motion) .hero__in--drift {
    animation-name: hero-drift-in;
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 2.5rem, 0);
    }
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes hero-drift-in {
    from {
      transform: translate3d(0, 1.25rem, 0);
    }
  }

  /* ── Contenido ─────────────────────────────────────────────────────────── */
  .hero__content {
    position: relative;
    display: grid;
    gap: var(--space-l);
  }
  /* Un punto más clara que el eyebrow global: va sobre el fondo con luz. */
  .hero__eyebrow {
    color: var(--text-soft);
  }
  .hero__title {
    font-size: var(--fs-display);
    max-width: 15.5em;
  }
  .hero__line {
    display: block;
  }
  .hero__line--soft {
    color: var(--text-muted);
  }
  .hero__title em {
    color: var(--accent-soft);
  }

  .hero__bottom {
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-s);
  }
  .hero__sub {
    font-size: var(--fs-lg);
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 44ch;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }
  @media (min-width: 64em) {
    .hero__bottom {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: var(--space-xl);
    }
    /* Botones algo más contenidos hasta pantallas grandes: a 1280 px los .btn--lg
       estándar dejaban el subtítulo en una columna de ~6 líneas. */
    .hero__ctas :global(.btn--lg) {
      --btn-h: clamp(3.5rem, 1.5rem + 3vw, 5.5rem);
      font-size: clamp(1.125rem, 0.4rem + 1.1vw, 1.875rem);
    }
  }
  @media (max-width: 29.999em) {
    .hero__ctas > div,
    .hero__ctas :global(.btn) {
      width: 100%;
    }
  }

  /* ── Indicador de scroll (escritorio) ──────────────────────────────────── */
  .hero__scroll {
    position: absolute;
    right: calc(var(--gutter) / 2 - 0.4rem); /* en el margen lateral: no pisa los CTA */
    bottom: var(--space-l);
    display: none;
    padding: 0.4rem;
    font-size: var(--fs-2xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    writing-mode: vertical-rl;
  }
  .hero__scroll-inner {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .hero__scroll-line {
    position: relative;
    /* medidas físicas: el padre está en writing-mode vertical */
    width: 1px;
    height: 3.5rem;
    background: var(--line);
    overflow: hidden;
  }
  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: translateY(-100%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__scroll-line::after {
      animation: scroll-cue 2.4s var(--ease-in-out) infinite;
    }
  }
  @keyframes scroll-cue {
    50% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(100%);
    }
  }
  @media (hover: hover) {
    .hero__scroll:hover {
      color: var(--text);
    }
  }
  @media (min-width: 64em) {
    .hero__scroll {
      display: inline-flex;
    }
  }
</style>
