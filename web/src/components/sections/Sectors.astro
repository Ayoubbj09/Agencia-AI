---
/**
 * 7.5 Para qué negocios (#sectores) — PROPIETARIO: Sección C.
 * Script: src/scripts/sections/sectors.ts (pin + scroll horizontal en escritorio).
 *
 * Fotos: ambientación generada con IA (nunca "clientes" ni "proyectos").
 * Se cargan TODAS las imágenes de src/assets/sectores/ automáticamente: para
 * añadir academia.webp basta con copiar el archivo en esa carpeta (el panel de
 * Academias pasará solo de composición tipográfica a foto; el alt ya está aquí).
 *
 * <Picture>: formats avif+webp, fallbackFormat 'webp' (por defecto Astro usaría
 * PNG para un .webp), widths 480/800/1086, eager + async (paneles fuera de
 * pantalla por el desplazamiento horizontal).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import WhatsAppButton from '../WhatsAppButton.astro';
import PrivacyNote from '../PrivacyNote.astro';

const imagenes = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/sectores/*.{webp,avif,jpg,jpeg,png}',
  { eager: true },
);
/** Imagen del sector por nombre de archivo (sin extensión) o undefined si no existe. */
const fotoDe = (slug: string) =>
  Object.entries(imagenes).find(([path]) => path.split('/').pop()?.split('.')[0] === slug)?.[1]
    .default;

const sectores = [
  {
    slug: 'inmobiliaria',
    name: 'Inmobiliarias',
    line: 'Responde dudas sobre tus pisos, filtra a los interesados y agenda visitas.',
    alt: 'Salón de un piso al atardecer, con unas llaves sobre la mesa y la ciudad iluminada al fondo.',
  },
  {
    slug: 'clinica',
    name: 'Clínicas',
    line: 'Resuelve dudas frecuentes, agenda citas y avisa a recepción cuando hace falta.',
    alt: 'Recepción tranquila de una clínica, con el mostrador iluminado, sillones y plantas.',
  },
  {
    slug: 'taller',
    name: 'Talleres',
    line: 'Recoge qué le pasa al coche, da cita y avisa al taller.',
    alt: 'Taller mecánico de noche, con un coche en el elevador y las herramientas ordenadas.',
  },
  {
    slug: 'gimnasio',
    name: 'Gimnasios',
    line: 'Informa de tarifas y horarios y apunta a clases de prueba.',
    alt: 'Gimnasio vacío con mancuernas, bañado por la luz del atardecer.',
  },
  {
    slug: 'restaurante',
    name: 'Restaurantes',
    line: 'Toma reservas y responde a preguntas frecuentes.',
    alt: 'Mesa para dos con una vela encendida y la cocina desenfocada al fondo.',
  },
  {
    slug: 'academia',
    name: 'Academias',
    line: 'Informa de cursos y precios y agenda pruebas de nivel.',
    alt: 'Aula vacía con pupitres y pizarra, con luz de atardecer.',
  },
].map((s) => ({ ...s, image: fotoDe(s.slug) }));
---

<section id="sectores" class="sectors section" aria-labelledby="sectores-title">
  <div class="sectors__intro container">
    <p class="eyebrow" data-reveal><span class="eyebrow__index">02</span> Sectores</p>
    <h2 id="sectores-title" class="sectors__title" data-reveal="split">
      <em>Empezamos</em> por las inmobiliarias.
    </h2>
    <p class="lead sectors__lead" data-reveal>
      El mismo enfoque se adapta a cualquier negocio que atienda clientes por WhatsApp.
    </p>
  </div>

  <div class="sectors__viewport" data-sectors-viewport data-lenis-prevent data-scroll-x>
    <ul class="sectors__track" role="list" data-sectors-track>
      {
        sectores.map((s, i) => (
          <li class:list={['sector', !s.image && 'sector--type']} data-sector={s.slug} data-cursor="Ver">
            <article class="sector__card">
              <div class="sector__frame" data-sector-frame>
                {s.image ? (
                  <Picture
                    src={s.image}
                    alt={s.alt}
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    widths={[480, 800, 1086]}
                    sizes="(min-width: 1024px) 480px, 80vw"
                    loading="eager"
                    decoding="async"
                    class="sector__img"
                    data-sector-img
                  />
                ) : (
                  <div class="sector__type" aria-hidden="true">
                    <span>{s.name}</span>
                  </div>
                )}
              </div>
              <div class="sector__body">
                <span class="sector__index" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="sector__name">{s.name}</h3>
                <p class="sector__line">{s.line}</p>
              </div>
            </article>
          </li>
        ))
      }
      <li class="sector sector--final" data-sector="otros">
        <article class="sector__card sector__card--final">
          <h3 class="sector__final-title">
            Comercios, despachos, centros de estética… ¿Tu sector no está? <em>Hablemos.</em>
          </h3>
          <div class="sector__final-cta">
            <WhatsAppButton label="Escríbenos por WhatsApp" />
            <PrivacyNote />
          </div>
        </article>
      </li>
    </ul>
  </div>

  <p class="sectors__note container" data-reveal="fade">Imágenes ilustrativas.</p>
</section>

<style>
  .sectors__intro {
    display: grid;
    gap: var(--space-m);
    margin-bottom: var(--space-xl);
  }
  .sectors__title {
    max-width: 12em;
  }
  .sectors__title em {
    color: var(--accent);
  }

  /* Versión base (sin JS / táctil): carrusel nativo con scroll-snap. */
  .sectors__viewport {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .sectors__viewport::-webkit-scrollbar {
    display: none;
  }
  .sectors__track {
    display: flex;
    gap: var(--grid-gap);
    width: max-content;
    padding-inline: var(--gutter);
    padding-bottom: var(--space-s);
  }
  .sector {
    flex: none;
    width: min(80vw, 30rem);
    scroll-snap-align: start;
  }
  .sector__card {
    display: grid;
    gap: var(--space-m);
  }
  /* Marco 4:5 sobre una foto 3:4: sobra un poco arriba/abajo para el parallax. */
  .sector__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--bg-elev);
  }
  .sector__frame :global(picture),
  .sector__frame :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sector__type {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: end start;
    padding: var(--space-m);
    background:
      radial-gradient(80% 60% at 70% 20%, rgb(255 107 44 / 0.22), transparent 70%),
      var(--bg-elev);
  }
  .sector__type span {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(3rem, 2rem + 4vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--accent-soft);
  }
  .sector__body {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-s);
    row-gap: 0.4rem;
  }
  .sector__index {
    grid-row: span 2;
    font-size: var(--fs-xs);
    color: var(--accent);
    padding-top: 0.6em;
    font-variant-numeric: tabular-nums;
  }
  .sector__name {
    font-size: var(--fs-h3);
  }
  .sector__line {
    color: var(--text-muted);
    max-width: 34ch;
  }

  .sector--final {
    width: min(86vw, 36rem);
  }
  .sector__card--final {
    height: 100%;
    align-content: space-between;
    gap: var(--space-xl);
    padding: var(--space-l);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-elev);
  }
  .sector__final-title {
    font-size: var(--fs-h3);
    line-height: 1.12;
  }
  .sector__final-title em {
    color: var(--accent);
  }
  .sector__final-cta {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
  }

  .sectors__note {
    margin-top: var(--space-m);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
</style>
