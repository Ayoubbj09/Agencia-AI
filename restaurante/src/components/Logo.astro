---
/**
 * Logotipo "Al Madina" + estrella de 8 puntas (zellige) + "المدينة".
 * Accesible: role="img" + aria-label. Con `decorative` se oculta a lectores.
 * El tamaño sale de `size` (todo va en em).
 */
interface Props {
  size?: string;
  decorative?: boolean;
  class?: string;
  /** Oculta el rótulo árabe (p. ej. en espacios muy estrechos). */
  noArabic?: boolean;
}
const { size, decorative = false, class: className, noArabic = false } = Astro.props;
---

<span
  class:list={['logo', className]}
  style={size ? `--logo-size: ${size}` : undefined}
  {...decorative ? { 'aria-hidden': 'true' } : { role: 'img', 'aria-label': 'Al Madina' }}
>
  <svg class="logo__star" viewBox="-10 -10 20 20" aria-hidden="true">
    <path d="M0-9 2.6-6.3 6.4-6.4 6.3-2.6 9 0 6.3 2.6 6.4 6.4 2.6 6.3 0 9-2.6 6.3-6.4 6.4-6.3 2.6-9 0-6.3-2.6-6.4-6.4-2.6-6.3Z" />
  </svg>
  <span class="logo__word" aria-hidden="true">Al Madina</span>
  {!noArabic && <span class="logo__ar" aria-hidden="true" lang="ar" dir="rtl">المدينة</span>}
</span>

<style>
  .logo {
    --logo-size: 1.375rem;
    display: inline-flex;
    align-items: center;
    gap: 0.38em;
    font-size: var(--logo-size);
    line-height: 1;
    color: var(--text);
    white-space: nowrap;
    user-select: none;
  }
  .logo__star {
    inline-size: 0.95em;
    block-size: 0.95em;
    fill: var(--accent);
    transition: transform 0.9s var(--ease-expo);
  }
  .logo__word {
    font-family: var(--font-sans);
    font-weight: 750;
    letter-spacing: -0.04em;
  }
  .logo__ar {
    font-family: var(--font-arabic);
    font-weight: 500;
    font-size: 0.78em;
    color: var(--accent);
    padding-inline-start: 0.1em;
    transform: translateY(-0.04em);
  }
  :global(a:hover) > .logo .logo__star,
  :global(a:focus-visible) > .logo .logo__star {
    transform: rotate(90deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .logo__star {
      transition: none;
    }
  }
</style>
