---
/**
 * Franja azafrán con texto en bucle (marquee). Solo CSS (transform); con
 * reduced motion queda quieta. Decorativa: el texto real va en sr-only.
 */
import { site } from '../../config/site';
const items = ['Restaurante marroquí', 'Para comer aquí', 'Para llevar', 'A domicilio', 'Hasta las 00:00', 'Salt · Girona'];
const run = [...items, ...items];
---

<div class="franja" role="region" aria-label="Al Madina en pocas palabras">
  <p class="sr-only">{items.join(' · ')}. {site.lema}</p>
  <div class="franja__track" aria-hidden="true">
    {
      [0, 1].map(() => (
        <span class="franja__group">
          {run.map((t) => (
            <span class="franja__item">
              {t}
              <svg class="franja__star" viewBox="-10 -10 20 20">
                <path d="M0-9 2.6-6.3 6.4-6.4 6.3-2.6 9 0 6.3 2.6 6.4 6.4 2.6 6.3 0 9-2.6 6.3-6.4 6.4-6.3 2.6-9 0-6.3-2.6-6.4-6.4-2.6-6.3Z" />
              </svg>
            </span>
          ))}
        </span>
      ))
    }
  </div>
</div>

<style>
  .franja {
    position: relative;
    background: var(--accent);
    color: var(--on-accent);
    overflow: clip;
    rotate: -1.5deg;
    margin-block: var(--space-l) calc(var(--space-l) * -1);
    inline-size: 104%;
    margin-inline-start: -2%;
    z-index: var(--z-raised);
  }
  .franja__track {
    display: flex;
    inline-size: max-content;
    animation: franja 60s linear infinite;
  }
  .franja__group {
    display: flex;
  }
  .franja__item {
    display: inline-flex;
    align-items: center;
    gap: 0.9em;
    padding: 0.55em 0 0.55em 0.9em;
    font-size: clamp(1.25rem, 0.9rem + 1.6vw, 2.25rem);
    font-weight: var(--fw-bold);
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  .franja__star {
    inline-size: 0.7em;
    block-size: 0.7em;
    fill: currentColor;
  }
  @keyframes franja {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .franja__track {
      animation: none;
    }
  }
</style>
