---
/**
 * Iconos de línea (monocromo, currentColor, decorativos: aria-hidden).
 * Uso: <Icon name="phone" />  ·  tamaño con `size` (por defecto 1em).
 */
interface Props {
  name: 'phone' | 'pin' | 'clock' | 'instagram' | 'tiktok' | 'star' | 'arrow' | 'bag' | 'scooter' | 'plate';
  size?: string;
  class?: string;
}
const { name, size = '1em', class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'phone' && <path d="M6.6 3.5h2.6l1.4 4-2 1.4a12.6 12.6 0 0 0 6.5 6.5l1.4-2 4 1.4v2.6a2 2 0 0 1-2.2 2A16.6 16.6 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z" />}
  {name === 'pin' && <><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.4" /></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></>}
  {name === 'instagram' && <><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="3.8" /><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" /></>}
  {name === 'tiktok' && <path d="M14 3.5v11.2a3.4 3.4 0 1 1-3.4-3.4M14 3.5c.4 2.6 2.2 4.3 4.8 4.5" />}
  {name === 'star' && <path d="m12 3.6 2.5 5.3 5.7.7-4.2 3.9 1.1 5.7L12 16.4l-5.1 2.8L8 13.5 3.8 9.6l5.7-.7L12 3.6Z" fill="currentColor" stroke="none" />}
  {name === 'arrow' && <path d="M5 12h13m-5-5 5 5-5 5" />}
  {name === 'bag' && <><path d="M5 8h14l-1 12H6L5 8Z" /><path d="M9 8V6.5a3 3 0 0 1 6 0V8" /></>}
  {name === 'scooter' && <><circle cx="6.5" cy="17" r="2.5" /><circle cx="17.5" cy="17" r="2.5" /><path d="M9 17h6l-2-7h-3M15 5h2l3 12M4 12h6" /></>}
  {name === 'plate' && <><circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="4.5" /></>}
</svg>
